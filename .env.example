# Fail2ban Dashboard Configuration

# Flask secret key (change this in production!)
SECRET_KEY=your-secret-key-change-this-in-production

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Server settings (used by both `python app.py` and gunicorn.conf.py)
FLASK_HOST=127.0.0.1
FLASK_PORT=8001
FLASK_DEBUG=false

# GeoIP cache (ip-api.com results are stored in SQLite so restarts don't re-query;
# failed lookups are retried after 10 minutes)
# Defaults to <repo>/data/geoip_cache.db; the directory is created automatically
#GEOIP_CACHE_PATH=/opt/fail2ban-dashboard/data/geoip_cache.db
#GEOIP_CACHE_TTL_DAYS=30

# Application log level (DEBUG / INFO / WARNING). Logs go to journald via gunicorn
#LOG_LEVEL=INFO
